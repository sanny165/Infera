# ---------------------------------------------------------------------------
# Document-Summarizer environment configuration
#
# LOCAL USE:
#   1. Copy this file to ".env"  (same folder as app.py)
#   2. Fill in your actual GROQ_API_KEY below
#   3. Never commit the real ".env" file (it's already in .gitignore)
#
# STREAMLIT COMMUNITY CLOUD USE:
#   Do NOT upload a .env file to GitHub. Instead, go to:
#     Your App -> Settings -> Secrets
#   and paste the same KEY = "value" pairs there (TOML format), e.g.:
#     GROQ_API_KEY = "gsk_your_real_key_here"
#     GROQ_MODEL = "openai/gpt-oss-120b"
# ---------------------------------------------------------------------------

# >>> REQUIRED: Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional overrides (safe to leave as defaults)
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
